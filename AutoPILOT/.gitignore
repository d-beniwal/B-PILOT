__pycache__/
*.pyc
.DS_Store
.venv/

# Draft plan files are generation output, not source -- never commit them.
generated_plans/*
!generated_plans/.gitkeep

# Per-installation runtime preferences (chat colors/font/model/temperature,
# optional Argo overrides) written by the settings dialog -- not source,
# should not carry machine-specific state between checkouts.
autopilot_settings.json

# Eval/fine-tuning fixture for the chat-dock pipeline -- a growing scratch
# set of test prompts, not source; keep it local rather than committing it.
prompts_cache/
